{
  "name": "dsh-bocha-web-search-plugin",
  "version": "0.2.2",
  "description": "Production Bocha Web Search provider and settings UI for DeepSeek Harness.",
  "repository": {
    "type": "git",
    "url": "https://github.com/kezan31/dsh-bocha-web-search-plugin.git"
  },
  "homepage": "https://github.com/kezan31/dsh-bocha-web-search-plugin#readme",
  "bugs": {
    "url": "https://github.com/kezan31/dsh-bocha-web-search-plugin/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "bocha",
    "web-search",
    "plugin"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/provider.js",
    "lib/client.js",
    "src/**/*.js",
    "scripts/build-client.mjs",
    "locale/*.json",
    "README.md",
    "README.en.md",
    "docs/**/*.jpg",
    "docs/**/*.jpeg",
    "composition.example.yml",
    "fixtures/**/*.json",
    "test/**/*.cjs",
    "cordis.patch.yml"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-credentials": "0.2.0-rc.2",
    "@deepseek-ai/dsh-launch-environment": "0.2.0-rc.2",
    "@deepseek-ai/dsh-web": "0.2.0-rc.2",
    "@deepseek-ai/dsh-web-search-deepseek": "0.2.0-rc.2"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.4"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-api-remotes"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "check": "node --check src/provider.js && node --check src/index.js && node --check src/client.js && node --check scripts/build-client.mjs && node --check lib/provider.js && node --check lib/index.js && node --check lib/client.js",
    "test:provider": "node test/provider-static.cjs",
    "test": "npm run build && npm run check && npm run test:provider",
    "prepublishOnly": "npm test"
  }
}
